<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cine_sensing_imu</name>
  <version>1.1.0</version>
  <description>Republishes MAVROS IMU data for VINS-Fusion, extracts gyroscope rates, and republishes VINS odometry as VIO pose.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/Kino-Studios/CINE-Sensing</url>
  <url type="bugtracker">https://github.com/Kino-Studios/CINE-Sensing/issues</url>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>cine_sensing_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
