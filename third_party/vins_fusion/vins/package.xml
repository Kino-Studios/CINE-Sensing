<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vins</name>
  <version>0.0.0</version>
  <description>Visual-inertial odometry estimator from VINS-Fusion: sliding-window optimisation of camera feature tracks and preintegrated IMU measurements.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <license>GPL-3.0-only</license>

  <author>HKUST Aerial Robotics Group</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <!-- Ceres 2.1 is not a rosdep key: rosdep would install 2.2, which removed LocalParameterization. Build it with tools/install_ceres_2_1.sh. -->
  <depend>rclcpp</depend>
  <depend>rcpputils</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>camera_models</depend>
  <depend>image_transport</depend>
  <!-- launch/generate_vins_config.py reads its values from cine_sensing_config. -->
  <exec_depend>cine_sensing_config</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
