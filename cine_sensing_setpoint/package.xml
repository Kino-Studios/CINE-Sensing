<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cine_sensing_setpoint</name>
  <version>1.1.0</version>
  <description>Forwards cinematography position, velocity, acceleration and attitude setpoints to MAVROS setpoint topics.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/Kino-Studios/CINE-Sensing</url>
  <url type="bugtracker">https://github.com/Kino-Studios/CINE-Sensing/issues</url>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
