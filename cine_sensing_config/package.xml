<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cine_sensing_config</name>
  <version>1.1.0</version>
  <description>Shared JSON configuration for the CINE-Sensing camera, IMU, YOLO and VIO nodes, with a Python loader that finds it in the install space.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/Kino-Studios/CINE-Sensing</url>
  <url type="bugtracker">https://github.com/Kino-Studios/CINE-Sensing/issues</url>

  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
